//making exel

document.getElementById("downloadExcel").onclick = () => {
    // Dummy participant data — replace with your actual data
      const roomKey = `participants-${roomName}`;
  const participantsData = JSON.parse(localStorage.getItem(roomKey)) || [];

  if (participantsData.length === 0) {
    alert("No data available.");
    return;
  }

  const formattedData = participantsData.map(p => ({
  "Name": p.name,
  "Roll No.": p.roll,
  "Admission No.": p.admission,
}));

    // 1. Create worksheet and workbook
    const worksheet = XLSX.utils.json_to_sheet(formattedData);

    // 2. Auto width calculation
    const columnWidths = Object.keys(participantsData[0]).map(key => {
      const maxLength = Math.max(
        key.length,
        ...participantsData.map(p => (p[key] ? p[key].toString().length : 0))
      );
      return { wch: maxLength + 1 }; // +2 padding
    });
    worksheet['!cols'] = columnWidths;

    // 3. Workbook creation
    const workbook = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(workbook, worksheet, "Participant Report");

    // 4. Styling: Add bold headers (manually mark them)
    const headerRange = XLSX.utils.decode_range(worksheet['!ref']);
    for (let C = headerRange.s.c; C <= headerRange.e.c; ++C) {
      const cellAddress = XLSX.utils.encode_cell({ c: C, r: 0 });
      if (worksheet[cellAddress]) {
        worksheet[cellAddress].s = {
          font: { bold: true },
          fill: { fgColor: { rgb: "DCE6F1" } },
          alignment: { horizontal: "center" }
        };
      }
    }

    // 5. Export to file
    XLSX.writeFile(workbook, `${roomName} NoProxy_Attendance_Report.xlsx`, { cellStyles: true });
  };

