<!DOCTYPE html>
<html>
<head>
  <title>Room: <%= roomName %></title>
 <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

  <style>
  body {
    font-family: 'Segoe UI', Tahoma, sans-serif;
    background-color: #0f0f1a;
    color: #e6f0ff;
    padding: 2rem;
    margin: 0;
    backdrop-filter: blur(6px);
    background-image: radial-gradient(circle at top left, #1e1e2f, #0f0f1a);
  }

  h2 {
    font-size: 1.8rem;
    color: #1E90FF;
    margin-bottom: 1rem;
    text-shadow: 0 0 6px rgba(30,144,255,0.5);
  }

  p, h3 {
    margin: 0.5rem 0;
  }

  #adminStatus {
    font-weight: bold;
    color: #00FFAA;
    margin-bottom: 1.2rem;
  }

  #adminArea {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    padding: 2rem;
    margin-top: 1rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
  }

  #qrcode {
    margin: 30px auto;
    background: #ffffff;
    padding: 15px;
    width: fit-content;
    border-radius: 12px;
    box-shadow: 0 0 20px rgba(30,144,255, 0.4);
  }

  #countdown {
    font-weight: bold;
    font-size: 1.5rem;
    color: #FF6F61;
  }

  h3 {
    color: #1E90FF;
    font-size: 1.4rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid #1E90FF;
    padding-bottom: 0.5rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    font-size: 0.95rem;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    overflow: hidden;
  }

  table th, table td {
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.8rem;
    text-align: center;
    backdrop-filter: blur(4px);
  }

  table th {
    background-color: rgba(30, 144, 255, 0.2);
    color: #ffffff;
    font-weight: 600;
  }

  table img.selfie {
    max-width: 150px;
    max-height: 150px;
    border-radius: 10px;
    border: 2px solid #1E90FF;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  table img.selfie:hover {
    transform: scale(2);
    z-index: 1000;
    position: relative;
  }

  #downloadExcel {
    margin-top: 2rem;
    background: linear-gradient(135deg, #1E90FF, #00BFFF);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 0.9rem 2rem;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(30, 144, 255, 0.3);
    transition: background 0.3s ease, transform 0.2s;
  }

  #downloadExcel:hover {
    transform: scale(1.05);
    background: linear-gradient(135deg, #00BFFF, #1E90FF);
  }

  @media (max-width: 768px) {
    table {
      font-size: 0.85rem;
    }

    #qrcode {
      width: 300px;
      height: 300px;
    }

    table img.selfie {
      max-width: 90px;
      max-height: 90px;
    }
  }
</style>

</head>
<body>
  <h2>🔐 Room: <%= roomName %></h2>
  <p id="adminStatus">Checking...</p>

  <div id="adminArea" style="display: none;">
    <div id="remove">
    <div id="qrcode"></div>
    
    <p>⏳ New QR in: <span id="countdown">--</span> seconds</p>
    </div>
      <div id="participantSection" style="margin-top: 30px;">
    <h3>👥 Participants</h3>
    <table border="1" id="participantsTable">
   <thead>
  <tr>
    <th>#</th>
    <th>Name</th>
    <th>Roll No</th>
    <th>Admission ID</th>
          <th>Selfie</th>
  </tr>
</thead>
      <tbody></tbody>
    </table>
  </div>
  </div>
<button id="downloadExcel">⬇️ Download Excel</button>

  <script>



const validEntryKeys = new Map();
 let userLocation = null;
//  async  function  getLocation() {
//   navigator.geolocation.getCurrentPosition(
//       async (pos) => 
//       {
//     const  { latitude, longitude } = await pos.coords;
//           userLocation={ latitude, longitude };
//            console.log(userLocation);
//       }, () => {
//         document.getElementById("address").innerText = "Permission denied or unavailable.";
//       },{
//   enableHighAccuracy: true,
//   timeout: 10000,
//   maximumAge: 0
// });

    // console.log(userLocation);
  // }
//  getLocation();
    const roomName = "<%= roomName %>";
    const time="<%= time %>";
     const time1=time*1000;
    const token = localStorage.getItem(`token-${roomName}`);

    const allowed = localStorage.getItem(`allowed-${roomName}`);
    const submitted = localStorage.getItem(`submitted-${roomName}`);
if (!token && (allowed !== "yes" || submitted === "yes")) {
  alert("Access denied.");
  window.location.href = "/";
}
    // Set isAdmin flag early and clearly
const isAdmin = !!token;
const socket = io({
  auth: { admin: true },
  query: { room: roomName }  // 👈 this is how server detects which room
});

    const adminStatus = document.getElementById("adminStatus");
    const adminArea = document.getElementById("adminArea");
    const countdownDisplay = document.getElementById("countdown");
    const qrcodeContainer = document.getElementById("qrcode");
    let currentSecret = "";
    let countdownInterval = null;

    // ❌ Block direct access
    if (!token && allowed !== "yes") {
      alert("Unauthorized access. Join via QR.");
      window.location.href = "/";
    }

    socket.emit("join-room", roomName);

    if (token) {
      adminStatus.textContent = "🧑‍💼 You are the admin";
      adminArea.style.display = "block";

      function generateSecret() {
        const code = Math.random().toString(36).substring(2, 8).toUpperCase();
        const payload = `${roomName}|${code}`;
        currentSecret = code;
        socket.emit("secret-code", { roomName, code, token });

        qrcodeContainer.innerHTML = "";
        new QRCode(qrcodeContainer, {
          text: payload,
          width: 400,
          height: 400,
        });
      }

      generateSecret();
    
      const intervalId = setInterval(generateSecret, time1);

    } else {
      adminStatus.textContent = "👤 You are a participant";
    }
    
function removeStudentByEntryKey(targetEntryKey) {
  // Step 1: Get the array from localStorage
   const roomKey = `participants-${roomName}`;
  const data = localStorage.getItem(roomKey);
  if (!data) return; // if no data, nothing to remove

  // Step 2: Parse the JSON string to array
  const students = JSON.parse(data);

  // Step 3: Filter out the one with the matching entryKey
  const updatedStudents = students.filter(student => student.entryKey !== targetEntryKey);

  // Step 4: Save the updated array back to localStorage
  localStorage.setItem(roomKey, JSON.stringify(updatedStudents));
}
 function removerow(row){
         row.remove();
 }
socket.on("cancel-attendance",({ roomName, entryKey })=>{
          const row =document.getElementById(entryKey);  
          if(row)
          {
             removerow(row);
              removeStudentByEntryKey(entryKey);
          }
          console.log(entryKey+" removed");
})
      window.addEventListener("beforeunload", () => {
        clearInterval(intervalId);
        clearInterval(countdownInterval);
        localStorage.removeItem(`token-${roomName}`);
        localStorage.removeItem(`allowed-${roomName}`);
        socket.emit("secret-code", { roomName, code: "❌ Admin Left", token });
      });


document.getElementById("downloadExcel").onclick = () => {
    const qr=document.getElementById("remove").remove();
    removerow= ()=>{};
    removeStudentByEntryKey=()=>{};
    socket.emit("attendence-marked", { roomName: roomName });
    // Dummy participant data — replace with your actual data
      const roomKey = `participants-${roomName}`;
  const participantsData = JSON.parse(localStorage.getItem(roomKey)) || [];

  if (participantsData.length === 0) {
    alert("No data available.");
    return;
  }

  const formattedData = participantsData.map(p => ({
  "Name": p.name,
  "Roll No.": p.roll,
  "Admission No.": p.admission,
}));

    // 1. Create worksheet and workbook
    const worksheet = XLSX.utils.json_to_sheet(formattedData);

    // 2. Auto width calculation
    const columnWidths = Object.keys(participantsData[0]).map(key => {
      const maxLength = Math.max(
        key.length,
        ...participantsData.map(p => (p[key] ? p[key].toString().length : 0))
      );
      return { wch: maxLength + 1 }; // +2 padding
    });
    worksheet['!cols'] = columnWidths;

    // 3. Workbook creation
    const workbook = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(workbook, worksheet, "Participant Report");

    // 4. Styling: Add bold headers (manually mark them)
    const headerRange = XLSX.utils.decode_range(worksheet['!ref']);
    for (let C = headerRange.s.c; C <= headerRange.e.c; ++C) {
      const cellAddress = XLSX.utils.encode_cell({ c: C, r: 0 });
      if (worksheet[cellAddress]) {
        worksheet[cellAddress].s = {
          font: { bold: true },
          fill: { fgColor: { rgb: "DCE6F1" } },
          alignment: { horizontal: "center" }
        };
      }
    }
  //  socket.emit("verified",{roomName});
    // 5. Export to file
    XLSX.writeFile(workbook, `${roomName} NoProxy_Attendance_Report.xlsx`, { cellStyles: true });
  };
    socket.on("secret-code", ({ code, generatedAt ,second}) => {
      currentSecret = code;
      
      if (countdownInterval) clearInterval(countdownInterval);
      let secondsLeft = time - Math.floor((Date.now() - generatedAt) / 1000);
      if (secondsLeft <= 0 || secondsLeft > time) secondsLeft = time;
      countdownDisplay.textContent = secondsLeft;

      countdownInterval = setInterval(() => {
        secondsLeft--;
        if (secondsLeft <= 0) {
          countdownDisplay.textContent = "0";
          clearInterval(countdownInterval);
        } else {
          countdownDisplay.textContent = secondsLeft;
        }
      }, 1000);
    });

    socket.on("request-latest-code", ({ newSocketId }) => {
      socket.emit("send-latest-code", {
        roomName,
        code: currentSecret,
        generatedAt: Date.now(),
        to: newSocketId,
      });
    });
  
    //join participents table addition
   const participantsTable = document.querySelector("#participantsTable tbody");

let participantIndex = 1;

socket.on("new-participant", ({ name, roll, entryKey,admission,selfie  }) => {
    // console.log(validEntryKeys.get(roomName).has(entryKey))
           // Request location

  if (!isAdmin) return;
      
      //  const distance = getDistanceInKm(userLocation.latitude, userLocation.longitude, latitudex, longitudex);
      //  const twodigitdis=distance.toFixed(2);
         let roomKey = `participants-${roomName}`;
         const data={  entryKey,name, roll,admission,location };
  let list = JSON.parse(localStorage.getItem(roomKey)) || [];
  list.push(data);
  localStorage.setItem(roomKey, JSON.stringify(list));
  const row = document.createElement("tr");
    row.id=entryKey;
  row.innerHTML = `
    <td>${participantIndex++}</td>
    <td>${name || "-"}</td>
    <td>${roll || "-"}</td>
    <td>${admission || "-"}</td>
        <td><img class="selfie" src="${selfie}" alt="Selfie" /></td>
  `;
  participantsTable.appendChild(row);
});
window.addEventListener('beforeunload', function () {
  localStorage.clear();
});


function removeStudentByEntryKey(targetEntryKey) {
  // Step 1: Get the array from localStorage
   const roomKey = `participants-${roomName}`;
  const data = localStorage.getItem(roomKey);
  if (!data) return; // if no data, nothing to remove

  // Step 2: Parse the JSON string to array
  const students = JSON.parse(data);

  // Step 3: Filter out the one with the matching entryKey
  const updatedStudents = students.filter(student => student.entryKey !== targetEntryKey);

  // Step 4: Save the updated array back to localStorage
  localStorage.setItem(roomKey, JSON.stringify(updatedStudents));
}
 function removerow(row){
         row.remove();
 }
socket.on("cancel-attendance",({ roomName, entryKey })=>{
          const row =document.getElementById(entryKey);  
          if(row)
          {
             removerow(row);
              removeStudentByEntryKey(entryKey);
          }
          console.log(entryKey+" removed");
})
      window.addEventListener("beforeunload", () => {
        clearInterval(intervalId);
        clearInterval(countdownInterval);
        localStorage.removeItem(`token-${roomName}`);
        localStorage.removeItem(`allowed-${roomName}`);
        socket.emit("secret-code", { roomName, code: "❌ Admin Left", token });
      });


document.getElementById("downloadExcel").onclick = () => {
    const qr=document.getElementById("remove");
    if(qr)
    {
      qr.remove();
    }
    removerow= ()=>{};
    removeStudentByEntryKey=()=>{};
    socket.emit("attendence-marked", { roomName: roomName });
    // Dummy participant data — replace with your actual data
      const roomKey = `participants-${roomName}`;
  const participantsData = JSON.parse(localStorage.getItem(roomKey)) || [];

  if (participantsData.length === 0) {
    alert("No data available.");
    return;
  }

  const formattedData = participantsData.map(p => ({
  "Name": p.name,
