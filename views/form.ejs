socket.on("entry-confirmed", () => {
  // ✅ Clear local storage for this room
  const room = "<%= roomName %>";
  localStorage.removeItem(`allowed-${room}`);
  localStorage.removeItem(`entryKey-${room}`);
  localStorage.setItem(`submitted-${room}`, "yes");

