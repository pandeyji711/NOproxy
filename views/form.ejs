      font-size: 1rem;
      border-radius: 8px;
      background-color: rgba(255, 255, 255, 0.1);
      color: #fff;
      border: 1px solid #00c3ff55;
      outline: none;
      margin-bottom: 1rem;
      transition: border 0.3s ease;
    }

    input:focus {
      border-color: #00c3ff;
    }

    button {
      background-color: #00c3ff;
      color: #000;
      border: none;
      border-radius: 8px;
      padding: 0.9rem 1.8rem;
      font-weight: bold;
      font-size: 1rem;
      cursor: pointer;
      transition: background-color 0.3s ease;
      margin-top: 1rem;
    }

    button:hover {
      background-color: #33d1ff;
    }

    video {
      margin-top: 1rem;
      border-radius: 10px;
      border: 2px solid #333;
    }

    #imgx {
      margin-top: 1rem;
      border-radius: 10px;
      max-width: 320px;
      border: 2px solid #00c3ff;
    }

    #status {
      margin-top: 1rem;
      color: #4caf50;
      font-weight: bold;
    }

    @media (max-width: 480px) {
      form {
        padding: 1.5rem;
      }

      input, button {
        font-size: 0.95rem;
      }

      video, canvas {
        width: 260px;
        height: 180px;
      }

      #imgx {
        width: 260px;
      }
    }
  </style>


