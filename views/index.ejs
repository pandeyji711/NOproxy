<!DOCTYPE html>
<html>
<head>
  <title>QR Room Join</title>
<script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
  <script src="https://unpkg.com/html5-qrcode"></script>
  <style>
    #reader { width: 300px; margin-top: 20px; }
    #status { font-weight: bold; margin-top: 1rem; color: green; }
  </style>
</head>
<body>
  <h1>🔐 QR Room System</h1>

  <!-- Admin Section -->
  <h3>Create Room (Admin)</h3>
  <input id="createInput" placeholder="Enter room name">
  <button id="createBtn">Create Room</button>
  <h3>intervel in seconds</h3>
 <input id="time" type="number" min="1" max="777">
  <!-- Participant Section -->
  <h3>Join Room (Participant)</h3>
  <button id="scanBtn">📷 Scan QR to Join</button>
  <div id="reader" style="display:none;"></div>

  <p id="status"></p>
   

  <script>
  const socket = io();
  const status = document.getElementById("status");

  // Room creation logic (Admin)
  document.getElementById("createBtn").onclick = () => {
    const room = document.getElementById("createInput").value.trim();
    if (!room) return status.textContent = "Please enter a room name";
    socket.emit("create-room", room);
  };

  socket.on("room-created", ({ roomName, adminToken }) => {
    localStorage.setItem(`token-${roomName}`, adminToken);
     const time=document.getElementById("time").value;
                // alert(time);
    window.location.href = `/room/${roomName}?time=${time}`;
  });

  socket.on("error-message", msg => status.textContent = msg);

  // QR Scanner logic (Participant)
document.getElementById("scanBtn").onclick = () => {
  document.getElementById("reader").style.display = "block";

  Html5Qrcode.getCameras().then(cameras => {
    if (cameras && cameras.length) {
      // ✅ Prefer back camera if available
      const backCam = cameras.find(cam =>
        cam.label.toLowerCase().includes("back")
      ) || cameras[0];

      const html5Qr = new Html5Qrcode("reader");

      html5Qr.start(
        { deviceId: { exact: backCam.id } },  // use selected camera
        { fps: 10, qrbox: 250 },
        qrContent => {
          const [roomName, scannedSecret] = qrContent.split("|");

          if (!roomName || !scannedSecret) {
            status.textContent = "❌ Invalid QR format";
            return;
          }

          // ✅ Verify with server
          socket.emit("verify-secret", { roomName, code: scannedSecret });

          socket.once("verified", ({ success }) => {
            if (success) {
              localStorage.setItem(`allowed-${roomName}`, "yes");

              // Generate entry key
              const generatedKey = Math.random().toString(36).substring(2, 9);
              localStorage.setItem(`entryKey-${roomName}`, generatedKey);
              socket.emit("register-entry-key", { roomName, entryKey: generatedKey });

              html5Qr.stop().then(() => {
                status.textContent = "✅ Verified! Redirecting...";
               
                window.location.href = `/form/${roomName}`;
              });
            } else {
              status.textContent = "❌ Invalid or expired QR";
            }
          });
        },
        err => {
          // silently ignore scan errors
        }
      );
    }
  }).catch(err => {
    status.textContent = "❌ Camera not available";
  });
  };
//   window.addEventListener('beforeunload', function () {
//   localStorage.clear();
// });

</script>

</body>
</html>
